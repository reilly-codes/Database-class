    style C2 fill:#ffffcc,stroke:#ffaa00
    style C3 fill:#ccffcc,stroke:#00aa00,stroke-width:3px
    style H1 fill:#f0f0f0,stroke:#666666,stroke-width:2px
    style H2 fill:#ccffcc,stroke:#00aa00,stroke-width:3px
    style H3 fill:#ffffcc,stroke:#ffaa00
    style W1 fill:#e5ffe5,stroke:#00aa00,stroke-width:2px
    style W2 fill:#fff5e5,stroke:#ff9900
    style W3 fill:#e5f2ff,stroke:#0066cc,stroke-width:3px
    style P1 fill:#ccffcc,stroke:#00aa00
    style P2 fill:#ffeecc,stroke:#ff9900
    style P3 fill:#fff0f0,stroke:#ff0000,stroke-width:4px
