    style N2 fill:#e5ffe5,stroke:#00aa00
    style N3 fill:#e5ffe5,stroke:#00aa00
    style N4 fill:#e5ffe5,stroke:#00aa00
    style N5 fill:#ccffcc,stroke:#00aa00,stroke-width:2px
    style D1 fill:#fff5e5,stroke:#ff9900
    style D2 fill:#ffeecc,stroke:#ff9900,stroke-width:2px
    style C1 fill:#e5f2ff,stroke:#0066cc
    style C2 fill:#fff5e5,stroke:#ff9900
    style C3 fill:#ffffcc,stroke:#666666,stroke-width:3px
    style E1 fill:#ffeecc,stroke:#ff9900
    style E2 fill:#ccffcc,stroke:#00aa00
    style E3 fill:#e5f2ff,stroke:#0066cc,stroke-width:2px
